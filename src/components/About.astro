---
import { Image } from "astro:assets";

import { translations } from "../i18n";
import type { Locale } from "../i18n";

import { UserRound } from "@lucide/astro";
import workspaceImage from "../assets/about/workspace.webp";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translations[locale];
---

<section id="about" class="px-6 py-24">
  <div class="mx-auto max-w-6xl">
    <div class="flex items-center gap-3">
      <UserRound size={32} stroke-width={1.8} aria-hidden="true"
        class="text-gray-900 dark:text-white" />

      <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">
        {t.sections.about}
      </h2>
    </div>

    <div class="mt-3 h-px w-24 bg-gray-300 dark:bg-slate-700"></div>

    <div class="mt-10 grid items-center gap-4 lg:grid-cols-[1fr_0.95fr] lg:gap-0">
      <div class="relative z-10">
        <h3 class="text-2xl font-semibold tracking-tight text-gray-900 dark:text-white sm:text-3xl">
          {t.about.title}
        </h3>

        <div class="mt-6 max-w-2xl space-y-5 text-base leading-7 text-gray-600 dark:text-slate-300">
          <p>{t.about.paragraphs.introduction}</p>

          <p>{t.about.paragraphs.development}</p>

          <p>{t.about.paragraphs.personal}</p>
        </div>
      </div>

      <div class="relative hidden min-h-[420px] items-center justify-start lg:flex">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(250,204,21,0.08),transparent_70%)] dark:bg-[radial-gradient(circle_at_center,rgba(59,130,246,0.10),transparent_70%)]"></div>

        <div class="relative -ml-8 h-[420px] w-[calc(100%+2rem)] max-w-xl overflow-hidden"
          style="mask-image: linear-gradient(to bottom, transparent 0%, black 8%, black 88%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 8%, black 88%, transparent 100%);">
          <Image src={workspaceImage} alt="" class="h-full w-full object-cover object-center opacity-90 dark:opacity-80" />

          <div class="absolute inset-y-0 left-0 w-1/3 bg-gradient-to-r from-[#07111f] via-[#07111f]/60 to-transparent"></div>
        </div>
      </div>
    </div>
  </div>
</section>