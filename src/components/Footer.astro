---
import { Github } from "simple-icons-astro";

import linkedinIcon from "../assets/icons/linkedin.svg";
---

<footer class="border-t border-gray-200 dark:border-slate-800">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-6 py-8 text-center sm:flex-row sm:items-center sm:justify-between sm:text-left">
    <div>
      <p class="text-sm font-medium text-gray-900 dark:text-white">
        © {new Date().getFullYear()} Adrià Matoses Garcia
      </p>

      <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">
        Software Developer
      </p>
    </div>

    <div class="flex items-center gap-5">
      <a href="https://github.com/amatosesg"
        target="_blank" rel="noopener noreferrer"
        aria-label="GitHub"
        class="text-gray-500 transition-colors hover:text-gray-900 dark:text-slate-400 dark:hover:text-white">
        <Github size={19} aria-hidden="true" />
      </a>

      <a href="https://www.linkedin.com/in/amatoses"
        target="_blank" rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="text-gray-500 transition-colors hover:text-gray-900 dark:text-slate-400 dark:hover:text-white">
        <img src={linkedinIcon.src} alt="" class="h-[19px] w-[19px]" />
      </a>

      <span class="h-4 w-px bg-gray-300 dark:bg-slate-700"></span>

      <a href="https://amatoses.dev"
        class="text-sm text-gray-500 transition-colors hover:text-gray-900 dark:text-slate-400 dark:hover:text-white">
        amatoses.dev
      </a>
    </div>
  </div>
</footer>