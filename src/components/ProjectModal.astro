---
import { Image } from "astro:assets";

import { translations } from "../i18n";
import { projects } from "../data/projects";
import type { Locale } from "../i18n";

import { ChevronLeft, ChevronRight, X } from "@lucide/astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translations[locale];
---

<dialog id="project-modal" aria-labelledby="project-modal-title"
  class="m-auto max-h-[80vh] w-[calc(100%-2rem)] max-w-3xl overflow-hidden rounded-2xl border border-gray-300/70 bg-[#fffdf7] p-0 text-gray-900 shadow-2xl backdrop:bg-black/60 dark:border-slate-700 dark:bg-slate-800 dark:text-white">
  <div class="max-h-[80vh] overflow-y-auto">
    <div class="flex items-center justify-end p-3">
      <button id="project-modal-close" type="button" aria-label={t.accessibility.closeProject}
        class="flex h-9 w-9 items-center justify-center rounded-full text-gray-600 transition-colors hover:bg-gray-200 dark:text-slate-300 dark:hover:bg-slate-700">
        <X size={20} stroke-width={1.8} aria-hidden="true" />
      </button>
    </div>

    <h2 id="project-modal-title" class="sr-only">
      {t.sections.projects}
    </h2>

    {projects.map((project) => {
      const content = t.projects[project.id];

      return (
        <div data-project-content={project.id} hidden class="px-5 pb-7 text-center sm:px-8 sm:text-left">
          {project.images.length === 0 ? (
            <div class="flex h-56 items-center justify-center rounded-xl bg-gray-100 text-sm text-gray-400 sm:h-72 dark:bg-slate-900 dark:text-slate-500">
              {t.projects.labels.preview}
            </div>
          ) : project.images.length === 1 ? (
            <div class="overflow-hidden rounded-xl bg-gray-100 dark:bg-slate-900">
              <Image
                src={project.images[0]}
                alt={content.title}
                loading="eager"
                decoding="async"
                class="h-56 w-full object-cover sm:h-72"
              />
            </div>
          ) : (
            <div class="project-carousel relative">
              <div class="overflow-hidden rounded-xl bg-gray-100 dark:bg-slate-900">
                {project.images.map((image, index) => (
                  <Image
                    src={image}
                    alt={`${content.title} - ${index + 1}`}
                    loading="eager"
                    decoding="async"
                    data-carousel-image
                    data-carousel-index={index}
                    class:list={[
                      "h-56 w-full object-cover sm:h-72",
                      index !== 0 && "hidden",
                    ]}
                  />
                ))}
              </div>

              <button type="button" data-carousel-prev
                aria-label={t.accessibility.previousImage}
                class="absolute left-3 top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-gray-800 shadow-md backdrop-blur-sm transition-colors hover:bg-white dark:bg-slate-800/90 dark:text-white dark:hover:bg-slate-700">
                <ChevronLeft size={20} stroke-width={1.8} aria-hidden="true" />
              </button>

              <button type="button" data-carousel-next
                aria-label={t.accessibility.nextImage}
                class="absolute right-3 top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-gray-800 shadow-md backdrop-blur-sm transition-colors hover:bg-white dark:bg-slate-800/90 dark:text-white dark:hover:bg-slate-700">
                <ChevronRight size={20} stroke-width={1.8} aria-hidden="true" />
              </button>

              <div class="mt-2 flex justify-center gap-1.5">
                {project.images.map((_, index) => (
                  <button type="button" data-carousel-dot data-carousel-index={index}
                    aria-label={`${index + 1}`}
                    class:list={[
                      "h-1.5 rounded-full transition-all",
                      index === 0
                        ? "w-5 bg-gray-700 dark:bg-slate-200"
                        : "w-1.5 bg-gray-300 dark:bg-slate-600",
                    ]}
                  ></button>
                ))}
              </div>
            </div>
          )}

          <h3 class="mt-3 text-2xl font-bold tracking-tight">
            {content.title}
          </h3>

          <div class="mt-4">
            <h4 class="text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-slate-400">
              {t.projects.labels.overview}
            </h4>

            <p class="mt-2 leading-7 text-gray-600 dark:text-slate-300">
              {content.overview}
            </p>
          </div>

          <div class="mt-5">
            <h4 class="text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-slate-400">
              {t.projects.labels.technologies}
            </h4>

            <div class="mt-3 flex flex-wrap justify-center gap-2 sm:justify-start">
              {project.technologies.map((technology) => (
                <span class="rounded-full bg-gray-100 px-3 py-1.5 text-sm text-gray-600 dark:bg-slate-700 dark:text-slate-300">
                  {technology}
                </span>
              ))}
            </div>
          </div>

          {(project.github || project.live) && (
            <div class="mt-7 flex flex-wrap justify-center gap-3 sm:justify-start">
              {project.github && (
                <a href={project.github} target="_blank" rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 rounded-full bg-gray-900 px-4 py-2.5 text-sm font-medium text-white transition-colors hover:bg-gray-700 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200">
                  {t.projectLinks.github}
                </a>
              )}

              {project.live && (
                <a href={project.live} target="_blank" rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 rounded-full border border-gray-300 px-4 py-2.5 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-100 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-700">
                  {t.projectLinks.live}
                </a>
              )}
            </div>
          )}
        </div>
      );
    })}
  </div>
</dialog>

<script src="../scripts/project-modal.ts"></script>