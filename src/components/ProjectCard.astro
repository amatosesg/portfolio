---
import { Image } from "astro:assets";

import type { Project } from "../data/projects";
import { translations } from "../i18n";
import type { Locale } from "../i18n";

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const t = translations[locale];

const content = t.projects[project.id];
const previewImage = project.images[0];
---

<button type="button" data-project-id={project.id} aria-haspopup="dialog"
  class="group flex h-full w-full cursor-pointer flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white text-left shadow-sm transition-transform duration-300 hover:-translate-y-1 hover:shadow-lg dark:border-slate-700 dark:bg-slate-800">
  <div class="aspect-video flex-none overflow-hidden bg-gray-100 dark:bg-slate-900">
    {previewImage ? (
      <Image
        src={previewImage}
        alt={content.title}
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
      />
    ) : (
      <div class="flex h-full items-center justify-center text-sm text-gray-400 dark:text-slate-500">
        {t.projects.labels.preview}
      </div>
    )}
  </div>

  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
      {content.title}
    </h3>

    <p class="mt-2 text-sm leading-6 text-gray-600 dark:text-slate-300">
      {content.description}
    </p>

    <div class="mt-auto flex flex-wrap gap-2 pt-4">
      {project.technologies.map((technology) => (
        <span class="rounded-full bg-gray-100 px-2.5 py-1 text-xs text-gray-600 dark:bg-slate-700 dark:text-slate-300">
          {technology}
        </span>
      ))}
    </div>
  </div>
</button>