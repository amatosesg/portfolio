---
import { translations } from "../i18n";
import { storageKeys } from "../config/storage";
import type { Locale } from "../i18n";

import { Moon, Sun } from "@lucide/astro";

const currentLocale = (Astro.currentLocale ?? "es") as Locale;
const t = translations[currentLocale];
---

<button
  type="button"
  class="theme-switcher flex items-center justify-center rounded-full p-2 text-gray-800 transition-colors hover:bg-gray-300 dark:text-gray-100 dark:hover:bg-slate-900"
  aria-label={t.accessibility.toggleThemeToLight}
  data-storage-key={storageKeys.theme}
  data-label-light={t.accessibility.toggleThemeToLight}
  data-label-dark={t.accessibility.toggleThemeToDark}>
  <Moon class="theme-icon-dark" size={18} stroke-width={1.8} aria-hidden="true" />
  <Sun class="theme-icon-light hidden" size={18} stroke-width={1.8} aria-hidden="true" />
</button>

<script src="../scripts/theme-switcher.ts"></script>