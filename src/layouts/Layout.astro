---
import "../styles/global.css";
import LocaleRedirect from "../components/LocaleRedirect.astro";
import Header from "../components/Header.astro";
import { translations } from "../i18n";
import { storageKeys } from "../config/storage";
import type { Locale } from "../i18n";

interface Props {
  lang: Locale;
  title?: string;
}

const { 
    lang, 
    title = "amatoses.dev" 
} = Astro.props;

const themeStorageKey = storageKeys.theme;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>

    <meta name="description" content={translations[lang].seo.description} />

    <meta name="theme-color" content="#0a0a0a" />

    <script is:inline define:vars={{ themeStorageKey }}>
      const savedTheme = localStorage.getItem(themeStorageKey);

      const theme =
        savedTheme === "dark" || savedTheme === "light"
          ? savedTheme
          : window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";

      document.documentElement.classList.toggle("dark", theme === "dark");
    </script>

    <LocaleRedirect />
  </head>

  <body>
    <Header />

    <main>
      <slot />
    </main>
  </body>
</html>